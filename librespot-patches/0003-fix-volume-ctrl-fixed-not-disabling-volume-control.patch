From c8c1c8904a5ada940d17e0919a2db60b816654f3 Mon Sep 17 00:00:00 2001
From: Dawid Krajcarz <80264606+drobotk@users.noreply.github.com>
Date: Mon, 17 Nov 2025 17:44:47 +0100
Subject: [PATCH] fix: volume-ctrl fixed not disabling volume control

Upstream librespot-org/librespot#1642. --volume-ctrl fixed set the mixer
curve but left ConnectConfig.disable_volume at its default (false), so
Spotify Connect could still change the softvol level. Set disable_volume
when the volume control is Fixed.

---
 src/main.rs | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/src/main.rs b/src/main.rs
index fb85803..92aebb9 100644
--- a/src/main.rs
+++ b/src/main.rs
@@ -1524,6 +1524,7 @@ async fn get_setup() -> Setup {
         let name = name.unwrap_or(connect_default_config.name);
         let device_type = device_type.unwrap_or(connect_default_config.device_type);
         let initial_volume = initial_volume.unwrap_or(connect_default_config.initial_volume);
+        let disable_volume = matches!(mixer_config.volume_ctrl, VolumeCtrl::Fixed);
         let volume_steps = volume_steps.unwrap_or(connect_default_config.volume_steps);
 
         ConnectConfig {
@@ -1531,8 +1532,8 @@ async fn get_setup() -> Setup {
             device_type,
             is_group,
             initial_volume,
+            disable_volume,
             volume_steps,
-            ..connect_default_config
         }
     };
 
-- 
